{
  "name": "scriptahub-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:auth && npm run build:books",
    "build:auth": "node tools/build_auth.mjs",
    "build:books": "node tools/build_books.mjs refresh",
    "test": "node --test tests/*.test.mjs",
    "test:catalogue": "node tools/check_catalogue.mjs && node tools/audit_internal_links.mjs --check"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "openid-client": "6.8.7",
    "parse5-sax-parser": "8.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
