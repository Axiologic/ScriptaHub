    {
      "id": "t000001",
      "source": "Cei care nu mai fug",
      "translation": ""
    },
    {
      "id": "t000002",
      "source": "CEI CARE",
      "translation": ""
    },
    {
      "id": "t000003",
      "source": "NU MAI FUG",
      "translation": ""
    },
    {
      "id": "t000004",
      "source": "roman science-fiction",
      "translation": ""
    },
    {
      "id": "t000005",
      "source": "EDIȚIE EXTINSĂ ȘI REVIZUITĂ",
      "translation": ""
    },
    {
      "id": "t000006",
      "source": "„Pacea nu elimină selecția.",
      "translation": ""
    },
    {
      "id": "t000007",
      "source": "Doar mută locul în care ea se petrece.”",
      "translation": ""
    },
    {
      "id": "t000008",
      "source": "REPERE ALE LUMII",
      "translation": ""
    },
    {
      "id": "t000009",
      "source": "Termen",
      "translation": ""
    },
    {
      "id": "t000010",
      "source": "Sens la începutul romanului",
      "translation": ""
    },
    {
      "id": "t000011",
      "source": "Arua",
      "translation": ""
    },
    {
      "id": "t000012",
      "source": "o lume blocată gravitațional, cu o emisferă arsă de lumină și una înghețată; viața densă se menține în Dunga de Amurg dintre ele.",
      "translation": ""
    },
    {
      "id": "t000013",
      "source": "Nivarii",
      "translation": ""
    },
    {
      "id": "t000014",
      "source": "o specie socială, fertilă și foarte sensibilă la pericol; au ochii laterali, vele auditive mobile, membre posterioare puternice și orașe săpate ori crescute sub rocă.",
      "translation": ""
    },
    {
      "id": "t000015",
      "source": "Liniștea Lungă",
      "translation": ""
    },
    {
      "id": "t000016",
      "source": "patru secole fără război, păstrate prin rotația Caselor provinciale, limitarea armelor, administrarea nașterilor și controlul central al hranei, luminii și infrastructurii.",
      "translation": ""
    },
    {
      "id": "t000017",
      "source": "Marea Auzire",
      "translation": ""
    },
    {
      "id": "t000018",
      "source": "rețeaua de calcul care corelează vibrațiile orașelor, registrele populației, producția și modelele ecologice; ea recomandă, iar instituțiile pretind adesea că doar execută.",
      "translation": ""
    },
    {
      "id": "t000019",
      "source": "Camera Măsurii",
      "translation": ""
    },
    {
      "id": "t000020",
      "source": "instituția care distribuie drepturile de naștere și resursele Dungii.",
      "translation": ""
    },
    {
      "id": "t000021",
      "source": "Ivarra și Vaor",
      "translation": ""
    },
    {
      "id": "t000022",
      "source": "capitala centrală a păcii, respectiv un domeniu de margine unde randamentul scade, populația este ascunsă, iar vechile răspunsuri nu mai ajung.",
      "translation": ""
    },
    {
      "id": "t000023",
      "source": "PERSONAJE LA ÎNCEPUTUL POVEȘTII",
      "translation": ""
    },
    {
      "id": "t000024",
      "source": "Sava Ilen —",
      "translation": ""
    },
    {
      "id": "t000025",
      "source": "demograf în Camera Măsurii; crede în necesitatea limitelor, dar cunoaște cruzimea lor administrativă.",
      "translation": ""
    },
    {
      "id": "t000026",
      "source": "Oru Ven —",
      "translation": ""
    },
    {
      "id": "t000027",
      "source": "partenerul Savei și inginer al rețelei radiculare; privește pacea ca pe un ecosistem care trebuie reparat, nu venerat.",
      "translation": ""
    },
    {
      "id": "t000028",
      "source": "Nemi —",
      "translation": ""
    },
    {
      "id": "t000029",
      "source": "fiica lor; sensibilă la sunet, curioasă și legată de unchiul ei.",
      "translation": ""
    },
    {
      "id": "t000030",
      "source": "Taren Ilen —",
      "translation": ""
    },
    {
      "id": "t000031",
      "source": "fratele mai tânăr al Savei; diagnosticat din copilărie cu întârziere a reflexului de fugă.",
      "translation": ""
    },
    {
      "id": "t000032",
      "source": "Seln Aru —",
      "translation": ""
    },
    {
      "id": "t000033",
      "source": "Custodele Ivarrei; apără ordinea planetară printr-o luciditate care rareori se prezintă drept violență.",
      "translation": ""
    },
    {
      "id": "t000034",
      "source": "Daran Veyr —",
      "translation": ""
    },
    {
      "id": "t000035",
      "source": "stăpânul Vaorului; cultivat, provocator și convins că centrul transformă în procedură moartea provinciilor.",
      "translation": ""
    },
    {
      "id": "t000036",
      "source": "Vessa Dahr —",
      "translation": ""
