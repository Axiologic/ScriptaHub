  "units": [
    {
      "id": "u000370",
      "chapterId": "chapter-0029",
      "kind": "h1",
      "text": "Evidence map and falsification criteria",
      "sourceAnchor": "p0391",
      "wordCount": 5
    },
    {
      "id": "u000371",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "The book has used three levels of certainty: robust and replicated findings; suggestive findings that depend on measurement and context; and speculative scenarios. The table below summarizes the claims supporting the central argument.",
      "sourceAnchor": "p0392",
      "wordCount": 33
    },
    {
      "id": "u000372",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "Claim",
      "sourceAnchor": null,
      "wordCount": 1
    },
    {
      "id": "u000373",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "Confidence",
      "sourceAnchor": null,
      "wordCount": 1
    },
    {
      "id": "u000374",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "Empirical basis",
      "sourceAnchor": null,
      "wordCount": 2
    },
    {
      "id": "u000375",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "What would falsify or limit it",
      "sourceAnchor": null,
      "wordCount": 6
    },
    {
      "id": "u000376",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "Personality has a moderate heritable component within populations.",
      "sourceAnchor": null,
      "wordCount": 8
    },
    {
      "id": "u000377",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "High",
      "sourceAnchor": null,
      "wordCount": 1
    },
    {
      "id": "u000378",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "Behavioral genetic meta-analysis; average h² ~0.40.",
      "sourceAnchor": null,
      "wordCount": 7
    },
    {
      "id": "u000379",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "It would be weakened by larger meta-analyses showing near-zero estimates after controlling for biases.",
      "sourceAnchor": null,
      "wordCount": 14
    },
    {
      "id": "u000380",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "Comparisons of mean personality levels across cultures are methodologically fragile.",
      "sourceAnchor": null,
      "wordCount": 10
    },
    {
      "id": "u000381",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "High",
      "sourceAnchor": null,
      "wordCount": 1
    },
    {
      "id": "u000382",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "Reviews of measurement invariance; lack of full scalar invariance.",
      "sourceAnchor": null,
      "wordCount": 9
    },
    {
      "id": "u000383",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "Instruments with robust scalar invariance across many populations would allow stronger comparisons.",
      "sourceAnchor": null,
      "wordCount": 12
    },
    {
      "id": "u000384",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "The Big Five structure is not reproduced identically in all societies.",
      "sourceAnchor": null,
      "wordCount": 11
    },
    {
      "id": "u000385",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "High for the existence of exceptions",
      "sourceAnchor": null,
      "wordCount": 6
    },
    {
      "id": "u000386",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "Tsimane; Karnataka sample; non-Western studies.",
      "sourceAnchor": null,
      "wordCount": 5
    },
    {
      "id": "u000387",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "Emic and etic replications consistently recovering the same structure would narrow the conclusion.",
      "sourceAnchor": null,
      "wordCount": 13
    },
    {
      "id": "u000388",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "Social niche diversity is associated with more statistically differentiated personality.",
      "sourceAnchor": null,
      "wordCount": 10
    },
    {
      "id": "u000389",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "Moderate to high",
      "sourceAnchor": null,
      "wordCount": 3
    },
    {
      "id": "u000390",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "Formal model plus cross-national analyses covering up to 115 countries.",
      "sourceAnchor": null,
      "wordCount": 10
    },
    {
      "id": "u000391",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "Longitudinal or quasi-experimental studies finding no changes when niches diversify.",
      "sourceAnchor": null,
      "wordCount": 10
    },
    {
      "id": "u000392",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "Fertility is generally lower in urban than rural Europe.",
      "sourceAnchor": null,
      "wordCount": 9
    },
    {
      "id": "u000393",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "High",
      "sourceAnchor": null,
      "wordCount": 1
    },
    {
      "id": "u000394",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "Eurostat and multinational regional studies.",
      "sourceAnchor": null,
      "wordCount": 5
    },
    {
      "id": "u000395",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "A persistent reversal of the gradient in most countries after controlling for composition.",
      "sourceAnchor": null,
      "wordCount": 13
    },
    {
      "id": "u000396",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "Some personality traits covary with number of children.",
      "sourceAnchor": null,
      "wordCount": 8
    },
    {
      "id": "u000397",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "Moderate",
      "sourceAnchor": null,
      "wordCount": 1
    },
    {
      "id": "u000398",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "Multicountry and cohort studies; small, heterogeneous effects.",
      "sourceAnchor": null,
      "wordCount": 7
    },
    {
      "id": "u000399",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "Preregistered meta-analyses finding stable null effects for all traits.",
      "sourceAnchor": null,
      "wordCount": 9
    },
    {
      "id": "u000400",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "Modern genetic selection on complex traits can be detected.",
      "sourceAnchor": null,
      "wordCount": 9
    },
    {
      "id": "u000401",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "Moderate to high",
      "sourceAnchor": null,
      "wordCount": 3
    },
    {
      "id": "u000402",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "Polygenic scores and reproductive data from Iceland/UK; reproductive success loci.",
      "sourceAnchor": null,
      "wordCount": 11
    },
    {
      "id": "u000403",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "If associations systematically disappear within families and independent samples, or are fully explained by stratification.",
      "sourceAnchor": null,
      "wordCount": 15
    },
    {
      "id": "u000404",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "Society genetically selects a universal psychological profile.",
      "sourceAnchor": null,
      "wordCount": 7
    },
    {
      "id": "u000405",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "Low / unsupported",
      "sourceAnchor": null,
      "wordCount": 2
    },
    {
      "id": "u000406",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "Gradients differ across countries; cross-cultural measurement is fragile.",
      "sourceAnchor": null,
      "wordCount": 8
    },
    {
      "id": "u000407",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "This would require cross-culturally replicable, heritable effects stable over many generations.",
      "sourceAnchor": null,
      "wordCount": 11
    },
    {
      "id": "u000408",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "Psychopathy affects ~1% or ~4.5% of the general population.",
      "sourceAnchor": null,
      "wordCount": 10
    },
    {
      "id": "u000409",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "Definition-dependent",
      "sourceAnchor": null,
      "wordCount": 1
    },
    {
      "id": "u000410",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "1.2% using PCL-R; 4.5% pooled across diverse instruments.",
      "sourceAnchor": null,
      "wordCount": 10
    },
    {
      "id": "u000411",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "A consensus instrument and threshold, applied representatively worldwide, would narrow the range.",
      "sourceAnchor": null,
      "wordCount": 12
    },
    {
      "id": "u000412",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "Urbanicity is associated with higher psychosis incidence.",
      "sourceAnchor": null,
      "wordCount": 7
    },
    {
      "id": "u000413",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "Moderate to high",
      "sourceAnchor": null,
      "wordCount": 3
    },
    {
      "id": "u000414",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "Meta-analysis: urban/rural IRR ~1.64.",
      "sourceAnchor": null,
      "wordCount": 6
    },
    {
      "id": "u000415",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "Natural experiments and causal models eliminating the association after accounting for confounders.",
      "sourceAnchor": null,
      "wordCount": 12
    },
    {
      "id": "u000416",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "Severe mental disorders tend to reduce fertility.",
      "sourceAnchor": null,
      "wordCount": 7
    },
    {
      "id": "u000417",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "High for several diagnoses",
      "sourceAnchor": null,
      "wordCount": 4
    },
    {
      "id": "u000418",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "Nordic registers; Icelandic genetic data.",
      "sourceAnchor": null,
      "wordCount": 5
    },
    {
      "id": "u000419",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "Representative cohorts in different contexts showing equal or higher fertility after adjustments.",
      "sourceAnchor": null,
      "wordCount": 12
    },
    {
      "id": "u000420",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "A metropolis of proximity may reduce arbitrary reproductive filtering.",
      "sourceAnchor": null,
      "wordCount": 9
    },
    {
      "id": "u000421",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "Speculative, testable",
      "sourceAnchor": null,
      "wordCount": 2
    },
    {
      "id": "u000422",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "Derived from mechanisms involving costs, time, housing, and support.",
      "sourceAnchor": null,
      "wordCount": 9
    },
    {
      "id": "u000423",
      "chapterId": "chapter-0029",
      "kind": "p",
      "text": "Urban planning or family interventions producing no change in realized fertility or parental well-being.",
      "sourceAnchor": null,
      "wordCount": 14
    }
  ]
}
