      "id": "t007487",
      "source": "N11. Time intervals and overlapping events",
      "translation": ""
    },
    {
      "id": "t007488",
      "source": "Problem 426. Overlapping historical intervals: case 1",
      "translation": ""
    },
    {
      "id": "t007489",
      "source": "Knowledge context.",
      "translation": ""
    },
    {
      "id": "t007490",
      "source": "Historical periods often overlap rather than forming a single neat sequence.",
      "translation": ""
    },
    {
      "id": "t007491",
      "source": "Given facts.",
      "translation": ""
    },
    {
      "id": "t007492",
      "source": "Event A lasted from year 100 to 140. Event B lasted from 100 to 131. Treat intervals as continuous for this exercise.",
      "translation": ""
    },
    {
      "id": "t007493",
      "source": "Rules.",
      "translation": ""
    },
    {
      "id": "t007494",
      "source": "Two intervals overlap when max(start times) < min(end times). Overlap length = min(end times) − max(start times), if positive.",
      "translation": ""
    },
    {
      "id": "t007495",
      "source": "Task.",
      "translation": ""
    },
    {
      "id": "t007496",
      "source": "Did the events overlap? If so, for how many years?",
      "translation": ""
    },
    {
      "id": "t007497",
      "source": "Step-by-step solution.",
      "translation": ""
    },
    {
      "id": "t007498",
      "source": "1. Later start=max(100,100)=100. 2. Earlier end=min(140,131)=131. 3. Difference=131−100=31.",
      "translation": ""
    },
    {
      "id": "t007499",
      "source": "Answer.",
      "translation": ""
    },
    {
      "id": "t007500",
      "source": "Yes, overlap 31 years.",
      "translation": ""
    },
    {
      "id": "t007501",
      "source": "Knowledge takeaway.",
      "translation": ""
    },
    {
      "id": "t007502",
      "source": "Interval reasoning distinguishes “before/after” from “overlapping in time.”",
      "translation": ""
    },
    {
      "id": "t007503",
      "source": "Formal model.",
      "translation": ""
    },
    {
      "id": "t007504",
      "source": "Interval intersection; compute max starts and min ends.",
      "translation": ""
    },
    {
