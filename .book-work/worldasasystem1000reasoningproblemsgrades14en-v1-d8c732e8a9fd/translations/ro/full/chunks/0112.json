      "id": "t007425",
      "source": "End population = start + births − deaths + in-migration − out-migration. Natural change and migration change are separate components.",
      "translation": ""
    },
    {
      "id": "t007426",
      "source": "Task.",
      "translation": ""
    },
    {
      "id": "t007427",
      "source": "Compute natural change, migration change, and the year-end population.",
      "translation": ""
    },
    {
      "id": "t007428",
      "source": "Step-by-step solution.",
      "translation": ""
    },
    {
      "id": "t007429",
      "source": "1. Natural change=23−12=11. 2. Migration change=34−29=5. 3. Total change=11+5=16. 4. End population=1250+16=1266.",
      "translation": ""
    },
    {
      "id": "t007430",
      "source": "Answer.",
      "translation": ""
    },
    {
      "id": "t007431",
      "source": "Natural change +11; migration change +5; end population 1266.",
      "translation": ""
    },
    {
      "id": "t007432",
      "source": "Knowledge takeaway.",
      "translation": ""
    },
    {
      "id": "t007433",
      "source": "Breaking total change into components helps explain why a population grew or shrank.",
      "translation": ""
    },
    {
      "id": "t007434",
      "source": "Formal model.",
      "translation": ""
    },
    {
      "id": "t007435",
      "source": "Balance equation P1=P0+births−deaths+in−out.",
      "translation": ""
