  "segments": [
    {
      "id": "t003158",
      "source": "End population = start + births − deaths + in-migration − out-migration. Natural change and migration change are separate components.",
      "translation": ""
    },
    {
      "id": "t003159",
      "source": "Task.",
      "translation": ""
    },
    {
      "id": "t003160",
      "source": "Compute natural change, migration change, and the year-end population.",
      "translation": ""
    },
    {
      "id": "t003161",
      "source": "Step-by-step solution.",
      "translation": ""
    },
    {
      "id": "t003162",
      "source": "1. Natural change=29−11=18. 2. Migration change=32−37=-5. 3. Total change=18+-5=13. 4. End population=1250+13=1263.",
      "translation": ""
    },
    {
      "id": "t003163",
      "source": "Answer.",
      "translation": ""
    },
    {
      "id": "t003164",
      "source": "Natural change +18; migration change -5; end population 1263.",
      "translation": ""
    },
    {
      "id": "t003165",
      "source": "Knowledge takeaway.",
      "translation": ""
    },
    {
      "id": "t003166",
      "source": "Breaking total change into components helps explain why a population grew or shrank.",
      "translation": ""
    },
    {
      "id": "t003167",
      "source": "Formal model.",
      "translation": ""
    },
    {
      "id": "t003168",
      "source": "Balance equation P1=P0+births−deaths+in−out.",
      "translation": ""
    },
    {
      "id": "t003169",
      "source": "Problem 175. Population balance in a town: case 5",
      "translation": ""
    },
    {
      "id": "t003170",
      "source": "Knowledge context.",
      "translation": ""
    },
    {
      "id": "t003171",
      "source": "Population changes through births, deaths, immigration, and emigration.",
      "translation": ""
    },
    {
      "id": "t003172",
      "source": "Given facts.",
      "translation": ""
    },
    {
      "id": "t003173",
      "source": "A town begins the year with 1300 residents. During the year: births=32, deaths=11, people moving in=32, people moving out=41.",
      "translation": ""
    },
    {
      "id": "t003174",
      "source": "Rules.",
      "translation": ""
    },
    {
      "id": "t003175",
      "source": "End population = start + births − deaths + in-migration − out-migration. Natural change and migration change are separate components.",
      "translation": ""
    },
    {
      "id": "t003176",
      "source": "Task.",
      "translation": ""
    },
    {
      "id": "t003177",
      "source": "Compute natural change, migration change, and the year-end population.",
      "translation": ""
    },
    {
      "id": "t003178",
      "source": "Step-by-step solution.",
      "translation": ""
    },
    {
      "id": "t003179",
      "source": "1. Natural change=32−11=21. 2. Migration change=32−41=-9. 3. Total change=21+-9=12. 4. End population=1300+12=1312.",
      "translation": ""
    },
    {
      "id": "t003180",
      "source": "Answer.",
      "translation": ""
    },
    {
      "id": "t003181",
      "source": "Natural change +21; migration change -9; end population 1312.",
      "translation": ""
    },
    {
      "id": "t003182",
      "source": "Knowledge takeaway.",
      "translation": ""
    },
    {
