    {
      "id": "t003275",
      "source": "Given facts.",
      "translation": ""
    },
    {
      "id": "t003276",
      "source": "Maya is a parent of Noah. Noah is a parent of Lina. Maya is also a parent of Owen. Owen is a parent of Sara.",
      "translation": ""
    },
    {
      "id": "t003277",
      "source": "Rules.",
      "translation": ""
    },
    {
      "id": "t003278",
      "source": "A parent is one generation above a child. A grandparent is two parent-links above. People who share a parent are siblings under this simplified model.",
      "translation": ""
    },
    {
      "id": "t003279",
      "source": "Task.",
      "translation": ""
    },
    {
      "id": "t003280",
      "source": "What family relation between Maya and Lina follows from the stated links?",
      "translation": ""
