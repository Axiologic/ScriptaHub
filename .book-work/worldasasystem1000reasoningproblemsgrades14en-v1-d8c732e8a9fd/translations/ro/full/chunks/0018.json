      "id": "t003281",
      "source": "Step-by-step solution.",
      "translation": ""
    },
    {
      "id": "t003282",
      "source": "1. Maya→Noah is one parent link. 2. Noah→Lina is a second parent link. 3. Two links give the grandparent relation.",
      "translation": ""
    },
    {
      "id": "t003283",
      "source": "Answer.",
      "translation": ""
    },
    {
      "id": "t003284",
      "source": "Maya is a grandparent of Lina.",
      "translation": ""
    },
    {
      "id": "t003285",
      "source": "Knowledge takeaway.",
      "translation": ""
    },
    {
      "id": "t003286",
      "source": "Family relations can be derived step by step from a small set of explicit links.",
      "translation": ""
    },
    {
      "id": "t003287",
      "source": "Formal model.",
      "translation": ""
