      "id": "t015318",
      "source": "N2. Coordinates and constraint-based location",
      "translation": ""
    },
    {
      "id": "t015319",
      "source": "Problem 881. Locating a point by constraints: case 1",
      "translation": ""
    },
    {
      "id": "t015320",
      "source": "Knowledge context.",
      "translation": ""
    },
    {
      "id": "t015321",
      "source": "Coordinates turn location into numbers. Multiple spatial clues can be treated as simultaneous constraints.",
      "translation": ""
    },
    {
      "id": "t015322",
      "source": "Given facts.",
      "translation": ""
    },
    {
      "id": "t015323",
      "source": "A point P lies on an integer grid with x,y from 0 to 8. It satisfies x+y=8 and x−y=0. It also satisfies x≥3.",
      "translation": ""
    },
    {
      "id": "t015324",
      "source": "Rules.",
      "translation": ""
    },
    {
      "id": "t015325",
      "source": "A location is valid only if it satisfies every stated equation and inequality at the same time.",
      "translation": ""
    },
    {
      "id": "t015326",
      "source": "Task.",
      "translation": ""
    },
    {
      "id": "t015327",
      "source": "Which coordinate(s) can P occupy? Is the solution unique?",
      "translation": ""
    },
    {
      "id": "t015328",
      "source": "Step-by-step solution.",
      "translation": ""
    },
    {
      "id": "t015329",
      "source": "1. List pairs satisfying x+y=8. 2. Keep only those also satisfying x−y=0. 3. The remaining set is [(4, 4)].",
      "translation": ""
    },
    {
      "id": "t015330",
      "source": "Answer.",
      "translation": ""
    },
    {
      "id": "t015331",
      "source": "P=(4, 4); the solution is unique.",
      "translation": ""
    },
    {
      "id": "t015332",
      "source": "Knowledge takeaway.",
      "translation": ""
    }
  ]
}
