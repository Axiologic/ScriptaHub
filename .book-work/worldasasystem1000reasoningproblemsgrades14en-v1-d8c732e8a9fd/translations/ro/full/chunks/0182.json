    {
      "id": "t011788",
      "source": "N11. Time intervals and overlapping events",
      "translation": ""
    },
    {
      "id": "t011789",
      "source": "Problem 676. Overlapping historical intervals: case 1",
      "translation": ""
    },
    {
      "id": "t011790",
      "source": "Knowledge context.",
      "translation": ""
    },
    {
      "id": "t011791",
      "source": "Historical periods often overlap rather than forming a single neat sequence.",
      "translation": ""
    },
    {
      "id": "t011792",
      "source": "Given facts.",
      "translation": ""
    },
    {
      "id": "t011793",
      "source": "Event A lasted from year 100 to 145. Event B lasted from 100 to 134. Treat intervals as continuous for this exercise.",
      "translation": ""
    },
    {
      "id": "t011794",
      "source": "Rules.",
      "translation": ""
    },
    {
      "id": "t011795",
      "source": "Two intervals overlap when max(start times) < min(end times). Overlap length = min(end times) − max(start times), if positive.",
      "translation": ""
    },
    {
      "id": "t011796",
      "source": "Task.",
      "translation": ""
    },
    {
      "id": "t011797",
      "source": "Did the events overlap? If so, for how many years?",
      "translation": ""
    },
    {
      "id": "t011798",
      "source": "Step-by-step solution.",
      "translation": ""
    },
    {
      "id": "t011799",
      "source": "1. Later start=max(100,100)=100. 2. Earlier end=min(145,134)=134. 3. Difference=134−100=34.",
      "translation": ""
    },
    {
      "id": "t011800",
      "source": "Answer.",
      "translation": ""
    },
    {
      "id": "t011801",
      "source": "Yes, overlap 34 years.",
      "translation": ""
    },
    {
      "id": "t011802",
      "source": "Knowledge takeaway.",
      "translation": ""
    },
    {
      "id": "t011803",
      "source": "Interval reasoning distinguishes “before/after” from “overlapping in time.”",
      "translation": ""
    },
    {
      "id": "t011804",
      "source": "Formal model.",
      "translation": ""
    },
    {
      "id": "t011805",
      "source": "Interval intersection; compute max starts and min ends.",
      "translation": ""
    },
