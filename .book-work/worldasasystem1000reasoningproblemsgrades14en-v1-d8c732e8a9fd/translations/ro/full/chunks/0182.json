      "source": "Given facts.",
      "translation": ""
    },
    {
      "id": "t011775",
      "source": "A town begins the year with 1500 residents. During the year: births=32, deaths=13, people moving in=36, people moving out=41.",
      "translation": ""
    },
    {
      "id": "t011776",
      "source": "Rules.",
      "translation": ""
