    {
      "id": "t011778",
      "source": "Task.",
      "translation": ""
    },
    {
      "id": "t011779",
      "source": "Compute natural change, migration change, and the year-end population.",
      "translation": ""
    },
    {
      "id": "t011780",
      "source": "Step-by-step solution.",
      "translation": ""
    },
    {
      "id": "t011781",
      "source": "1. Natural change=32−13=19. 2. Migration change=36−41=-5. 3. Total change=19+-5=14. 4. End population=1500+14=1514.",
      "translation": ""
    },
    {
      "id": "t011782",
      "source": "Answer.",
      "translation": ""
    },
    {
      "id": "t011783",
      "source": "Natural change +19; migration change -5; end population 1514.",
      "translation": ""
