    {
      "id": "t011760",
      "source": "End population = start + births − deaths + in-migration − out-migration. Natural change and migration change are separate components.",
      "translation": ""
    },
    {
      "id": "t011761",
      "source": "Task.",
      "translation": ""
    },
    {
      "id": "t011762",
      "source": "Compute natural change, migration change, and the year-end population.",
      "translation": ""
    },
    {
      "id": "t011763",
      "source": "Step-by-step solution.",
      "translation": ""
    },
    {
      "id": "t011764",
      "source": "1. Natural change=29−13=16. 2. Migration change=36−37=-1. 3. Total change=16+-1=15. 4. End population=1450+15=1465.",
      "translation": ""
    },
    {
      "id": "t011765",
      "source": "Answer.",
      "translation": ""
    },
    {
      "id": "t011766",
      "source": "Natural change +16; migration change -1; end population 1465.",
      "translation": ""
    },
    {
      "id": "t011767",
      "source": "Knowledge takeaway.",
      "translation": ""
    },
    {
      "id": "t011768",
      "source": "Breaking total change into components helps explain why a population grew or shrank.",
      "translation": ""
    },
    {
      "id": "t011769",
      "source": "Formal model.",
      "translation": ""
    },
    {
      "id": "t011770",
      "source": "Balance equation P1=P0+births−deaths+in−out.",
      "translation": ""
    },
    {
      "id": "t011771",
      "source": "Problem 675. Population balance in a town: case 5",
      "translation": ""
    },
    {
      "id": "t011772",
      "source": "Knowledge context.",
      "translation": ""
    },
    {
      "id": "t011773",
