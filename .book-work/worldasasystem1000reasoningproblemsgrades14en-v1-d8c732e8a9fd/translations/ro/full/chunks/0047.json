    },
    {
      "id": "t003274",
      "source": "Knowledge context.",
      "translation": ""
    },
    {
      "id": "t003275",
      "source": "Genealogies are relational graphs. Generation distance can be counted through parent links.",
      "translation": ""
    },
    {
      "id": "t003276",
      "source": "Given facts.",
      "translation": ""
    },
    {
      "id": "t003277",
      "source": "Maya is a parent of Noah. Noah is a parent of Lina. Maya is also a parent of Owen. Owen is a parent of Sara.",
      "translation": ""
    },
    {
      "id": "t003278",
      "source": "Rules.",
      "translation": ""
    },
    {
      "id": "t003279",
      "source": "A parent is one generation above a child. A grandparent is two parent-links above. People who share a parent are siblings under this simplified model.",
      "translation": ""
    },
