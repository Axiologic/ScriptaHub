  "subtitle": {
    "en": "A History of Civilization as Collective Psychopathy: How Groups Learn to Lie, Exploit, and Kill Without a Conscience",
    "fr": "A History of Civilization as Collective Psychopathy: How Groups Learn to Lie, Exploit, and Kill Without a Conscience",
