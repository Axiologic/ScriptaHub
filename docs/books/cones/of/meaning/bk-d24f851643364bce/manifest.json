  "subtitle": {
    "en": "Meta-Rationality, Outfinitism, and Alignment in the Age of Generative Intelligence",
    "fr": "Meta-Rationality, Outfinitism, and Alignment in the Age of Generative Intelligence",
    "de": "Meta-Rationality, Outfinitism, and Alignment in the Age of Generative Intelligence",
    "es": "Meta-Rationality, Outfinitism, and Alignment in the Age of Generative Intelligence",
    "pt": "Meta-Rationality, Outfinitism, and Alignment in the Age of Generative Intelligence",
    "it": "Meta-Rationality, Outfinitism, and Alignment in the Age of Generative Intelligence",
