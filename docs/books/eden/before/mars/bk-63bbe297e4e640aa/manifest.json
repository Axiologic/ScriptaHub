  "subtitle": {
    "en": "If We Can Build Worlds Beyond Earth, We Can Build Paradise Here",
    "fr": "If We Can Build Worlds Beyond Earth, We Can Build Paradise Here",
    "de": "If We Can Build Worlds Beyond Earth, We Can Build Paradise Here",
    "es": "If We Can Build Worlds Beyond Earth, We Can Build Paradise Here",
