  "subtitle": {
    "en": "A Technofeudal Gospel After the Death of Democracy",
    "fr": "A Technofeudal Gospel After the Death of Democracy",
    "de": "A Technofeudal Gospel After the Death of Democracy",
    "es": "A Technofeudal Gospel After the Death of Democracy",
    "pt": "A Technofeudal Gospel After the Death of Democracy",
