  "subtitle": {
    "en": "Complexity, Victims Without Persecutors, and the Future of Responsibility",
    "fr": "Complexity, Victims Without Persecutors, and the Future of Responsibility",
    "de": "Complexity, Victims Without Persecutors, and the Future of Responsibility",
    "es": "Complexity, Victims Without Persecutors, and the Future of Responsibility",
    "pt": "Complexity, Victims Without Persecutors, and the Future of Responsibility",
