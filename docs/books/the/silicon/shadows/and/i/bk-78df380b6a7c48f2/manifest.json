  "subtitle": {
    "en": "A novel about care, freedom and refusal",
    "fr": "A novel about care, freedom and refusal",
    "de": "A novel about care, freedom and refusal",
    "es": "A novel about care, freedom and refusal",
    "pt": "A novel about care, freedom and refusal",
