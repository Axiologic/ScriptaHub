  "subtitle": {
    "en": "The Justification of Hypocrisy in a Finite World",
    "fr": "The Justification of Hypocrisy in a Finite World",
    "de": "The Justification of Hypocrisy in a Finite World",
    "es": "The Justification of Hypocrisy in a Finite World",
    "pt": "The Justification of Hypocrisy in a Finite World",
