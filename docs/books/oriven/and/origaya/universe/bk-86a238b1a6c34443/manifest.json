  "subtitle": {
    "en": "A civilisation disturbed by a distant first killing",
    "fr": "A civilisation disturbed by a distant first killing",
    "de": "A civilisation disturbed by a distant first killing",
    "es": "A civilisation disturbed by a distant first killing",
    "pt": "A civilisation disturbed by a distant first killing",
