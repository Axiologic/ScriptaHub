  "subtitle": {
    "en": "Humanity’s Greatest Challenges and the Ideas, Institutions, and Technologies That Can Build a Better Future",
    "fr": "Humanity’s Greatest Challenges and the Ideas, Institutions, and Technologies That Can Build a Better Future",
    "de": "Humanity’s Greatest Challenges and the Ideas, Institutions, and Technologies That Can Build a Better Future",
    "es": "Humanity’s Greatest Challenges and the Ideas, Institutions, and Technologies That Can Build a Better Future",
