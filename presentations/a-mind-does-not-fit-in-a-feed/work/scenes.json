  {
    "id": "why",
    "title": "Full day, unfinished idea",
    "labels": [
      "Unfinished idea",
      "Continuity",
      "Impression"
    ],
    "lines": [
      "You can meet many ideas in one day and still not say what you understood.",
      "A Mind Does Not Fit in a Feed asks why abundance can leave an idea unfinished.",
      "Its adversary is not the short form, but the impression of understanding.",
      "It defends intellectual continuity: time for a question to develop and face contradiction."
    ],
    "emotionalPlan": {
      "arc": "recognition rising into a clear, sober claim",
      "purpose": "Name a familiar paradox, then show what the book argues and what it does not attack.",
      "states": [
        "quiet recognition",
        "curiosity",
        "precise distinction",
        "steady conviction"
      ],
      "intensities": [
        0.4,
        0.5,
        0.6,
        0.65
      ],
      "voiceDirections": [
        "Warm and close, as if describing the listener's own evening.",
        "Lift slightly on the question, unhurried.",
        "Clear contrast between the two halves, no sarcasm.",
        "Settled and confident, stress continuity."
      ]
    },
