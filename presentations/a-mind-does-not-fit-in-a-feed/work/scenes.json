  {
    "id": "how",
    "title": "Evidence before the verdict",
    "labels": [
      "Context debt",
      "Evidence",
      "False coherence"
    ],
    "lines": [
      "Chapter One calls a fragment's hidden premises and alternatives “context debt,” a working concept.",
      "Chapter Two separates research findings, plausible interpretations and normative recommendations about attention.",
      "Chapter Three holds books to account: padding, false coherence and borrowed authority."
    ],
    "emotionalPlan": {
      "arc": "analytical tension resolved by fairness",
      "purpose": "Show the method: precise concepts, honest evidence and self-criticism of books.",
      "states": [
        "analytic focus",
        "measured rigour",
        "candid self-scrutiny"
      ],
      "intensities": [
        0.55,
        0.6,
        0.7
      ],
      "voiceDirections": [
        "Even pace, gentle emphasis on context debt, neutral on the caveat.",
        "Crisp and methodical, small pauses between the three categories.",
        "Slightly wry honesty, firm on the list."
      ]
    },
