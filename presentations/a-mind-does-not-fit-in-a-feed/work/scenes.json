  {
    "id": "what",
    "title": "A thought you finish",
    "labels": [
      "Small change",
      "Stable editions",
      "Prologue"
    ],
    "lines": [
      "Chapter Four turns agreement into action: one small, verifiable change, proposed rather than proven.",
      "Chapter Five lets blogs, short explanations and stable editions cooperate instead of compete.",
      "Read it to learn when you have truly earned the words “I understood.”",
      "Begin with the prologue, “A full day, an unfinished idea,” and stay with one question."
    ],
    "emotionalPlan": {
      "arc": "practical openness easing into a concrete invitation",
      "purpose": "Show what the reader gains and give a real starting point.",
      "states": [
        "practical encouragement",
        "generous openness",
        "quiet conviction",
        "inviting calm"
      ],
      "intensities": [
        0.6,
        0.55,
        0.65,
        0.45
      ],
      "voiceDirections": [
        "Encouraging and concrete, honest on the caveat.",
        "Open and constructive, no hostility toward the internet.",
        "Slower, let the quoted words land.",
        "Warm and unhurried, a quiet invitation to begin."
      ]
    },
