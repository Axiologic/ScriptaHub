  {
    "id": "what",
    "title": "Change one fact",
    "labels": [
      "Minimal pairs",
      "Fear",
      "Anger"
    ],
    "lines": [
      "Mara faces a running dog, a locked gate and a dead-end alley: fear.",
      "Now she can shut the gate, and the owner freed the dog deliberately: anger should rise.",
      "Such minimal pairs reveal whether an AI explains emotion or only matches words.",
      "Read it for that test, starting with Chapter 1, “An Emotion Is Not a Word.”"
    ],
    "emotionalPlan": {
      "arc": "tension of a concrete scene, a pivot, then a confident invitation",
      "purpose": "Demonstrate the counterfactual test on the book's own example and give a specific starting point.",
      "states": [
        "tension",
        "turn",
        "insight",
        "invitation"
      ],
      "intensities": [
        0.7,
        0.75,
        0.55,
        0.5
      ],
      "voiceDirections": [
        "Quicker and tighter, then a short pause before 'fear'.",
        "Shift tone decisively on 'anger', firm but not loud.",
        "Slow down; let the distinction register.",
        "Warm, direct invitation, unhurried on the chapter title."
      ]
    },
