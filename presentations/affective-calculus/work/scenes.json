  {
    "id": "how",
    "title": "The appraisal vector",
    "labels": [
      "Ontology",
      "Vector",
      "Prototypes"
    ],
    "lines": [
      "Its proposed Appraisal Affective Calculus first separates brief episodes from moods, sentiments and attitudes.",
      "An appraisal vector then records goals, control, agency, norms, dignity and attachment.",
      "Labels become probabilistic prototypes, with intensity and confidence reported separately."
    ],
    "emotionalPlan": {
      "arc": "careful construction, building a usable instrument step by step",
      "purpose": "Show the method precisely without jargon overload.",
      "states": [
        "methodical",
        "building",
        "assured"
      ],
      "intensities": [
        0.4,
        0.5,
        0.45
      ],
      "voiceDirections": [
        "Measured pace; give each category its own small beat.",
        "Slightly brighter, listing dimensions with even rhythm.",
        "Calm and exact, a light emphasis on 'separately'."
      ]
    },
