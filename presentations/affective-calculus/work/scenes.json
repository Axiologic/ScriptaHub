  {
    "id": "why",
    "title": "Not just a word",
    "labels": [
      "Label",
      "Subtext",
      "Appraisal"
    ],
    "lines": [
      "Affective Calculus asks whether an AI can explain an emotion, not merely name it.",
      "A character can say “I’m perfectly fine” in a scene of despair.",
      "An AI judge hunting for emotion words mistakes that expression for the actual state.",
      "The book treats emotion as an evaluated relationship between an agent and its world."
    ],
    "emotionalPlan": {
      "arc": "curiosity sharpens into recognition of a real problem",
      "purpose": "Identify the book and why its question matters within the first twenty seconds.",
      "states": [
        "intrigue",
        "quiet irony",
        "concern",
        "clarity"
      ],
      "intensities": [
        0.6,
        0.45,
        0.55,
        0.5
      ],
      "voiceDirections": [
        "Open with a confident, curious lift on 'explain'.",
        "Soften; let the quoted words land with gentle irony.",
        "Steady and precise, a slight frown in the voice.",
        "Settle warmly, as a clear definition."
      ]
    },
