  {
    "id": "scene-4",
    "title": "Read the route of the appeal",
    "chapter": "Read the route of the appeal",
    "lens": "reader",
    "sources": [
      4,
      38,
      39,
      42
    ],
    "lines": [
      "Begin with The Victim No One Persecuted and trace how responsibility becomes dispersed.",
