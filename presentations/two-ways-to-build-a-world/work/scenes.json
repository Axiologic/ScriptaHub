    "id": "why",
    "title": "After the golden age",
    "labels": [
      "Eisler's contrast",
      "Coordination",
      "Relative cost"
    ],
    "lines": [
      "A nearly forty-year-old idea claims societies keep organizing around partnership or domination.",
      "Two Ways to Build a World keeps Riane Eisler's contrast and drops the peaceful golden age.",
      "It treats domination and partnership as two recurring ways people coordinate under power.",
      "Its central claim is that technology and institutions change which way is cheaper."
    ],
    "emotionalPlan": {
      "arc": "recognition of an old contested idea, then clarity about what the book rescues and why it matters now",
      "purpose": "Identify the book, its honest correction of the myth, and its central claim within twenty-five seconds.",
      "states": [
        "intrigued",
        "candid",
        "focused",
        "pointed"
      ],
      "intensities": [
        0.6,
        0.45,
        0.5,
        0.7
      ],
      "voiceDirections": [
        "Open with quiet weight, let 'partnership or domination' land as the stakes.",
        "Plain and fair, a small turn on 'drops'.",
        "Steady and explanatory, stress 'coordinate'.",
        "Lean in slightly on 'technology and institutions' and 'cheaper'."
      ]
    },
