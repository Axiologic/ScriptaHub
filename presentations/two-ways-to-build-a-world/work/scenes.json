  {
    "id": "what",
    "title": "Partnership needs teeth",
    "labels": [
      "Commons rules",
      "Empire machine",
      "Coordinate system"
    ],
    "lines": [
      "Drawing on commons governance, it shows cooperation needs boundaries, monitoring, graduated sanctions, and appeal.",
      "Artificial intelligence can become an empire machine, or it can lower the cost of partnership.",
      "Start with Chapter 3, From Binary to Coordinate System, and learn to map who holds power."
    ],
    "emotionalPlan": {
      "arc": "practical firmness, a sharp present-day stake, then an inviting concrete starting point",
      "purpose": "Deliver the book's design lessons and its AI stakes, and give the reader a specific place to begin.",
      "states": [
        "firm",
        "urgent",
        "inviting"
      ],
      "intensities": [
        0.55,
        0.8,
        0.5
      ],
      "voiceDirections": [
        "Grounded and practical, no sermon.",
        "Contrast the two halves, slight pause before 'or'.",
        "Friendly and direct, name the chapter clearly, warm lift on 'who holds power'."
      ]
    },
