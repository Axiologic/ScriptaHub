  {
    "id": "why",
    "title": "A future grown small",
    "labels": [
      "Small future",
      "Fatigue",
      "Unfinished"
    ],
    "lines": [
      "The Unfinished World opens with a strange diagnosis: our future has begun to look small.",
      "We inherited machines that edit genes and reach other worlds, yet our mood is often fatigue.",
      "This book argues for hope without denying climate risk, war, or concentrated power.",
      "Its starting fact is simple: almost everything we care about is still unfinished."
    ],
    "emotionalPlan": {
      "arc": "Recognition of a quiet cultural weariness rises into the surprising claim that the world is still open.",
      "purpose": "Identify the book, its diagnosis and why it deserves attention within the first thirty seconds.",
      "states": [
        "intrigue",
        "wry recognition",
        "sober honesty",
        "opening release"
      ],
      "intensities": [
        0.55,
        0.45,
        0.4,
        0.65
      ],
      "voiceDirections": [
        "Curious and clear, lean slightly on 'small'.",
        "Light irony, contrast the achievements with the tired ending.",
        "Steady and serious, no drama on the list of dangers.",
        "Warm lift, let 'unfinished' land with a short pause."
      ]
    },
