  {
    "id": "what",
    "title": "Cooperation without prophets",
    "labels": [
      "Oracle",
      "Incomplete tribes",
      "Correction"
    ],
    "lines": [
      "Its proposed discovery system weighs claims rather than names, and must never become an oracle.",
      "Its incomplete tribes offer real shared work while protecting disagreement, outside ties and departure.",
      "Read it to learn how commitment can survive correction without waiting for a messiah.",
      "Begin with “Who Gets Heard,” and ask which contest your trusted voices won."
    ],
    "emotionalPlan": {
      "arc": "tension releases into constructive hope and a direct, personal invitation",
      "purpose": "Present the book's proposals honestly as proposals, give a specific reason to read and a real starting chapter.",
      "states": [
        "careful",
        "hopeful",
        "inviting",
        "personal"
      ],
      "intensities": [
        0.45,
        0.55,
        0.65,
        0.5
      ],
      "voiceDirections": [
        "Careful and precise, a slight caution on 'never become an oracle'.",
        "Warmer, open, as if describing a place worth joining.",
        "Lift gently, sincere invitation, light stress on 'survive correction'.",
        "Close and conversational, a small smile on the final question."
      ]
    },
    "chapter": "03 · Cooperation without prophets",
