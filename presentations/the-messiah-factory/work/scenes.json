  {
    "id": "how",
    "title": "Audiences make prophets",
    "labels": [
      "Attention",
      "Credibility",
      "Persona"
    ],
    "lines": [
      "It first separates attention, credibility, authority, performance and welfare into different contests.",
      "Audiences reward some versions of a speaker until that persona becomes the speaker's livelihood.",
      "The danger begins when no evidence can genuinely reduce the center's authority."
    ],
    "emotionalPlan": {
      "arc": "precise analysis builds tension as the feedback loop closes",
      "purpose": "Show the book's method: distinguishing contests and tracing the leader-audience relationship.",
      "states": [
        "analytical",
        "watchful",
        "tense"
      ],
      "intensities": [
        0.4,
        0.6,
        0.75
      ],
      "voiceDirections": [
        "Measured and clear, giving each of the five contests its own beat.",
        "Slightly slower, observant, letting 'livelihood' land.",
        "Quiet and firm, a grave weight on 'no evidence' without drama."
      ]
    },
