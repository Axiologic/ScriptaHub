  {
    "id": "why",
    "title": "Who gets heard",
    "labels": [
      "Selection",
      "Audience",
      "Allegiance"
    ],
    "lines": [
      "The Messiah Factory asks why the power to persuade keeps passing for understanding.",
      "Its suspicion is that becoming audible may reward fixed answers over revisable thought.",
      "Yet the book also refuses the flattering story of the ignored genius.",
      "Its real subject is how coordinating a group becomes control over what it may question."
    ],
    "emotionalPlan": {
      "arc": "curiosity sharpens into an uneasy recognition, then steadies into fair-minded inquiry",
      "purpose": "Name the book, its hook and why it deserves attention within the first twenty seconds.",
      "states": [
        "intrigued",
        "uneasy",
        "even-handed",
        "focused"
      ],
      "intensities": [
        0.55,
        0.65,
        0.45,
        0.6
      ],
      "voiceDirections": [
        "Open warmly with a hint of challenge, light stress on 'passing for understanding'.",
        "Lower slightly, thoughtful, as if sharing a private suspicion.",
        "Turn with a small, honest 'yet', fair and unhurried.",
        "Settle into clear, grounded emphasis on 'what it may question'."
      ]
    },
