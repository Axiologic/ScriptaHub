    "id": "why",
    "title": "Comfort without surrender",
    "labels": [
      "Automated order",
      "Infrastructure",
      "Irreplaceable leadership"
    ],
    "lines": [
      "Imagine an automated order offering comfort, safety and varied experiences, if you hand it governance.",
      "This book takes that offer seriously, answering with twenty-one debatable clauses of a new social contract.",
      "Its fear is not scarcity, but a leadership that controls automated infrastructure and cannot be replaced."
    ],
    "emotionalPlan": {
      "arc": "Curiosity at a tempting offer, sharpening into concern about irreplaceable control.",
      "purpose": "Identify the book, its central offer and why it deserves attention within the first thirty seconds.",
