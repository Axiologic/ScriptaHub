  {
    "id": "how",
    "title": "Traps and ignition",
    "labels": [
      "Success trap",
      "Dream compression",
      "Ignition"
    ],
    "lines": [
      "The author shows how safeguards, metrics and early evaluation make beginnings costly.",
      "Dreams get judged as credentials or business models before they gain depth.",
      "Ignition needs a reachable first step, visible consequences and enough control to change the work.",
      "The book also confronts cults, bubbles, burnout and the unpaid passion tax."
    ],
    "emotionalPlan": {
      "arc": "diagnosis builds tension, turns to constructive conditions, then grounds itself in honest limits",
      "purpose": "show the book's method: fair diagnosis of institutions, concrete conditions, and its awareness of enthusiasm's shadow",
      "states": [
        "analytical concern",
        "gentle frustration",
        "constructive hope",
        "sober honesty"
      ],
      "intensities": [
        0.45,
        0.55,
        0.65,
        0.45
      ],
      "voiceDirections": [
        "steady, explanatory pace",
        "slight weight on 'before they gain depth'",
        "brighter, listing each condition clearly",
        "lower and frank, no irony"
      ]
