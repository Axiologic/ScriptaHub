  {
    "id": "how",
    "title": "The hostile-ruler test",
    "labels": [
      "Hostile leader",
      "Stopping power",
      "Evidence limits"
    ],
    "lines": [
      "Its test is adversarial: judge each system by what a hostile leader could do.",
      "Then ask how the people affected could stop that leader.",
      "Liberalism, Chinese order, private cities and guaranteed income all face the same scrutiny.",
      "Appendices separate supported claims from hypothesis, and the book turns its test on itself."
    ],
    "emotionalPlan": {
      "arc": "Tension builds as the method is applied evenly to every camp, then releases into intellectual honesty.",
      "purpose": "Show the book's distinctive method and its fairness across political positions.",
      "states": [
        "resolve",
        "pointed",
        "even-handed",
        "candid"
      ],
      "intensities": [
        0.65,
        0.7,
        0.55,
        0.4
      ],
      "voiceDirections": [
        "Firm and measured, stress hostile.",
        "Brief pause before stop, then direct.",
        "Steady listing pace, no favourites.",
        "Warmer, reassuring honesty."
      ]
    },
