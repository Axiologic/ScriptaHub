  {
    "id": "what",
    "title": "Building the power to refuse",
    "labels": [
      "Captured attention",
      "AI dependence",
      "Counterpower"
    ],
    "lines": [
      "Markets can let winners close entry, and floods of noise can silence speech without censors.",
      "Artificial intelligence may cheapen expertise while handing power to whoever owns the infrastructure.",
      "A free order, the book argues, is measured by what citizens can refuse without starving.",
      "Begin with chapter one, Antinomies Are Not Accidents, and run its test on your favourite system."
    ],
    "emotionalPlan": {
      "arc": "Concrete dangers sharpen the stakes, the central criterion releases them, and the invitation turns them toward the reader.",
      "purpose": "Give selected content, the essential message and a specific starting point for reading.",
      "states": [
        "concern",
        "watchful",
        "conviction",
        "inviting challenge"
      ],
      "intensities": [
        0.6,
        0.55,
        0.75,
        0.5
      ],
      "voiceDirections": [
        "Clear and concrete, slight edge.",
        "Even, avoiding alarm.",
        "Slow down; land refuse without starving.",
        "Open and warm, a direct invitation."
      ]
    },
