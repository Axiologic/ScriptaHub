  },
  {
    "id": "source-175",
    "heading": "Appendix A. Design Invariants for Trustworthy Harnesses",
    "anchor": "page_100",
    "start": 186484,
    "end": 186858
  },
  {
    "id": "source-176",
    "heading": "1. Separate answer from capability",
    "anchor": "",
    "start": 186858,
    "end": 187213
  },
  {
    "id": "source-177",
    "heading": "2. Keep authority stable during active execution",
    "anchor": "",
    "start": 187213,
    "end": 187615
  },
  {
    "id": "source-178",
    "heading": "3. Make meaningful work visible",
    "anchor": "",
    "start": 187615,
    "end": 187947
  },
  {
    "id": "source-179",
    "heading": "4. Treat interpretation as an operation",
    "anchor": "",
    "start": 187947,
    "end": 188235
  },
  {
    "id": "source-180",
    "heading": "5. Use the minimum sufficient local context and authority",
    "anchor": "",
    "start": 188235,
    "end": 188568
  },
  {
    "id": "source-181",
    "heading": "6. Preserve provisional status",
    "anchor": "page_101",
    "start": 188568,
    "end": 188881
  },
  {
    "id": "source-182",
    "heading": "7. Match qualification to the claim",
    "anchor": "",
    "start": 188881,
    "end": 189200
  },
  {
    "id": "source-183",
    "heading": "8. Preserve honest non-resolution",
    "anchor": "",
    "start": 189200,
    "end": 189520
  },
  {
    "id": "source-184",
    "heading": "9. Reconsider locally",
    "anchor": "",
    "start": 189520,
    "end": 189824
  },
  {
    "id": "source-185",
    "heading": "10. Record operational trace, not private thought",
    "anchor": "",
    "start": 189824,
    "end": 190169
  },
  {
    "id": "source-186",
    "heading": "11. Make replay possible",
    "anchor": "",
    "start": 190169,
    "end": 190469
  },
  {
    "id": "source-187",
    "heading": "12. Separate memory statuses",
    "anchor": "page_102",
    "start": 190469,
    "end": 190782
  },
  {
    "id": "source-188",
    "heading": "13. Separate invention from adoption",
    "anchor": "",
    "start": 190782,
    "end": 191039
  },
  {
    "id": "source-189",
    "heading": "14. Publish coherent generations",
    "anchor": "",
    "start": 191039,
    "end": 191324
  },
  {
    "id": "source-190",
    "heading": "15. Evaluate the system, not only the answer",
    "anchor": "",
    "start": 191324,
    "end": 191674
  },
  {
    "id": "source-191",
    "heading": "16. Prefer specialised, federated claims",
    "anchor": "",
    "start": 191674,
    "end": 191983
  },
  {
    "id": "source-192",
    "heading": "17. Keep code and natural-language procedure complementary",
    "anchor": "",
    "start": 191983,
    "end": 192295
  },
  {
    "id": "source-193",
    "heading": "18. Keep the framework fallible",
    "anchor": "",
    "start": 192295,
    "end": 192616
  },
  {
    "id": "source-194",
    "heading": "19. Treat trustworthiness as a system and lifecycle property",
    "anchor": "page_103",
    "start": 192616,
    "end": 192896
  },
  {
    "id": "source-195",
    "heading": "20. Bind governance and compliance evidence to intended use",
    "anchor": "",
    "start": 192896,
    "end": 193210
  },
