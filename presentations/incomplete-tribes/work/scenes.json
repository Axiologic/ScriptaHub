  {
    "id": "how",
    "title": "Deep, Never Total",
    "labels": [
      "Jurisdiction",
      "Other loyalties",
      "Exit"
    ],
    "lines": [
      "Chapter Nine defines an incomplete tribe: thick cooperation without total authority over members.",
      "A chess club may govern tournament conduct, but not a member's romantic life.",
      "Other loyalties count as safeguards, so no group becomes the sole source of truth and affection.",
      "Exit and dissent stay open, so disagreement is not treated as betrayal."
    ],
    "emotionalPlan": {
      "arc": "definition to concrete reassurance",
      "purpose": "Show the book's method: constitutional limits on groups, made tangible through its own examples.",
      "states": [
        "precise focus",
        "light amusement",
        "growing conviction",
        "calm relief"
      ],
      "intensities": [
        0.5,
        0.4,
        0.6,
        0.45
      ],
      "voiceDirections": [
        "Measured, definitional; small pause after the colon.",
        "Lightly wry, let the example land.",
        "Build gently toward 'truth and affection'.",
        "Settle down; reassuring and unhurried."
      ]
    },
