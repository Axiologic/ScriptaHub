  {
    "id": "why",
    "title": "Good People First?",
    "labels": [
      "Saying we",
      "Enemies",
      "Architecture"
    ],
    "lines": [
      "Incomplete Tribes is an essay on a dangerous question: must humanity become good before civilization works?",
      "Its answer is architectural: change the design of belonging, not human nature.",
      "We love, build and mourn in groups, yet loyalty can turn neighbours into enemies."
    ],
    "emotionalPlan": {
      "arc": "provocation to recognition",
      "purpose": "Name the book, its unsettling question and why belonging must be redesigned rather than abolished.",
      "states": [
        "provocative curiosity",
        "clarifying confidence",
        "tender unease"
      ],
      "intensities": [
        0.6,
        0.5,
        0.55
      ],
      "voiceDirections": [
        "Name the book plainly, then pose the question for real, lifting on 'good before'.",
        "Steady and clear; lean on 'architectural'.",
        "Warm on the first half, quieter and graver on 'enemies'."
      ]
    },
